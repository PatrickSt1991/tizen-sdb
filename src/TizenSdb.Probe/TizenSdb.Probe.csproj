<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- Throwaway on-device gate: proves the engine's TCP+RSA-AUTH and the
		     C14N/RSA re-sign actually RUN on Android/MonoVM. Not the real app. -->
		<TargetFramework>net10.0-android</TargetFramework>
		<SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
		<OutputType>Exe</OutputType>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationId>nl.madebypatrick.tizensdbprobe</ApplicationId>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<AndroidManifest>Properties/AndroidManifest.xml</AndroidManifest>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\TizenSdb.Core\TizenSdb.Core.csproj" />
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Include="Portable.BouncyCastle" Version="1.9.0" />
	</ItemGroup>
</Project>
